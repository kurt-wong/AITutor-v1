# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_tutor

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO
MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# LLM Gateway mode: "mock" | "live"
LLM_GATEWAY_MODE=mock

# DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# MIMO API
MIMO_API_KEY=your_mimo_api_key
MIMO_BASE_URL=https://api.mimo.com/v1

# Vision Model API (Phase 2)
# DeepSeek VL — primary vision model for image analysis
DEEPSEEK_VL_API_KEY=your_deepseek_api_key
DEEPSEEK_VL_BASE_URL=https://api.deepseek.com/v1
# Qwen VL — fallback vision model
QWEN_VL_API_KEY=your_qwen_api_key
QWEN_VL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# App
DEBUG=false

# OCR Configuration
# Primary OCR provider: "paddleocr" | "simpletex"
OCR_PROVIDER=paddleocr
# Use mock mode for testing (no real OCR calls)
OCR_MOCK_MODE=true

# PaddleOCR Configuration
# Use GPU acceleration (requires CUDA)
PADDLEOCR_USE_GPU=false
# Language model: "ch" for Chinese, "en" for English
PADDLEOCR_LANG=ch

# SimpleTex Configuration (Cloud OCR for formula recognition)
# Get API key from: https://simpletex.cn/
SIMPLETEX_API_KEY=your_simpletex_api_key
SIMPLETEX_API_URL=https://server.simpletex.cn/api/latex_ocr

# Embedding Configuration
# Primary embedding provider: "ollama" | "openai"
EMBEDDING_PROVIDER=ollama
# Embedding model name
EMBEDDING_MODEL=qwen3-embedding:4b
# Use mock mode for testing
EMBEDDING_MOCK_MODE=true
# Vector dimension (0 = auto-detect)
EMBEDDING_DIMENSION=0

# Ollama Configuration (Local LLM/Embedding server)
OLLAMA_BASE_URL=http://localhost:11434

# ── Admin 认证（缺失时服务拒绝启动）──
ADMIN_API_KEY=change-me-to-a-long-random-secret

# MinIO bucket
MINIO_BUCKET=ai-tutor

# ── PP-StructureV3 文档解析（百度星河 API，生产必需）──
PADDLEOCR_VL_ENABLED=true
PADDLEOCR_VL_TOKEN=your_baidu_aistudio_token
# 布局/公式来源: api | vl | hybrid（见 PIPELINE.md）
PADDLEOCR_VL_LAYOUT_MODE=api
PADDLEOCR_VL_FORMULA_MODE=api
PADDLEOCR_VL_API_TIMEOUT=300
PADDLEOCR_VL_MAX_RETRIES=2

# ── VL OCR（主 VL: Qwen 3.6 Plus，Session #77 起）──
VL_PRIMARY=qwen
VL_OCR_ENABLED=true
VL_OCR_MODEL=qwen3.6-plus
QWEN_VL_MODEL=qwen3.6-plus
VL_OCR_CONFIDENCE_THRESHOLD=0.75
LLM_VERIFY_CONFIDENCE_THRESHOLD=0.85

# ── LLM 标注 — 一次性标注完整试卷 Markdown → JSON → 直接入库（替代逐题正则拆分）──
# Session #114: v3.0 主路径（LLM 全量提取），默认启用。失败自动回退正则管线。
LLM_ANNOTATION_ENABLED=true

# ── 题目结构化模式 (Phase 3+ / Session #99) ──
# regex  — 现有 structurer.py regex 解析（默认，稳定）
# hybrid — regex 切分 + LLM 组合标注（每道题 1 次调用，~$0.0008/题，需 PP-StructureV3 api 模式）
# llm    — 全 LLM 管线（预留）
PADDLEOCR_ANNOTATION_MODE=regex

# ── 并行提取管线 ──
PARALLEL_EXTRACTION_ENABLED=true
PARALLEL_EXTRACTION_WORKERS=4
PARALLEL_EXTRACTION_DPI=200
PARALLEL_EXTRACTION_SCAN_THRESHOLD=50
